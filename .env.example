# -------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/menhely_db?schema=public"

# -------------------------------------------------------
# NextAuth.js
# -------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this"
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------------------
# OAuth providers (optional)
# -------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# -------------------------------------------------------
# File upload (pl. Cloudinary / S3)
# -------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -------------------------------------------------------
# Stripe (fizetések, adományok, előfizetések)
# -------------------------------------------------------
# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
# Stripe Dashboard → Developers → Webhooks → Signing secret
# Lokálisan: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."
# Vercel Blob (fájl feltöltések)
BLOB_READ_WRITE_TOKEN=""

# -------------------------------------------------------
# Email (pl. Resend / SMTP)
# -------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="noreply@menhely.hu"

# -------------------------------------------------------
# Data Warehouse (külön Neon adatbázis)
# -------------------------------------------------------
DWH_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/menhely_dwh?schema=public"

# -------------------------------------------------------
# ETL API (védett endpoint)
# -------------------------------------------------------
# Generálj egy titkos tokent: openssl rand -hex 32
ETL_SECRET="change-this-to-a-random-secret"

# -------------------------------------------------------
# Seed API (védett endpoint)
# -------------------------------------------------------
# Generálj egy titkos tokent: openssl rand -hex 32
SEED_SECRET="change-this-to-a-random-secret"
# Csak akkor szükséges, ha production-ben is futtatnád:
# ALLOW_SEED_IN_PROD="true"

# -------------------------------------------------------
# App
# -------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MenhelyAdopt"

# -------------------------------------------------------
# Cron job authentication
# -------------------------------------------------------
# Generate with: openssl rand -hex 32
CRON_SECRET=your-secret-here
