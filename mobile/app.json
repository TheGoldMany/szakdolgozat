{
  "expo": {
    "name": "Állati Menhelyek",
    "slug": "allati-menhelyek",
    "version": "1.0.0",
    "scheme": "allatimenhelyek",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "sdkVersion": "56.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hu.allatimenhelyek.app"
    },
    "android": {
      "package": "hu.allatimenhelyek.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
