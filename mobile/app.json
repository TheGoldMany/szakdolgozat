{
  "expo": {
    "name": "Állati Menhelyek",
    "slug": "allati-menhelyek",
    "version": "1.0.0",
    "scheme": "allatimenhelyek",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "sdkVersion": "56.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hu.allatimenhelyek.app"
    },
    "android": {
      "package": "hu.allatimenhelyek.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E6F4FE",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Az ÁllatiMenhelyek a kamerát a helyszínen készített fotókhoz használja: elveszett vagy talált állat bejelentéséhez, illetve napi kép feltöltéséhez.",
          "photosPermission": "Az ÁllatiMenhelyek a fotóidhoz azért kér hozzáférést, hogy a bejelentéshez vagy a napi képhez korábban készült fotót is választhass.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
