# A backend címe. Lokális fejlesztéshez másold .env-be és írd át.
#
# Az Expo SDK 56 az EXPO_PUBLIC_ előtagú változókat build időben behelyettesíti,
# tehát ez a böngészőbe/appba BEKERÜL — titkot ide soha ne írj.
#
# Szimulátorban a localhost a szimulátor saját gépét jelenti, ezért a fejlesztő
# gép IP-címe kell (pl. http://192.168.0.10:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000

# iOS push értesítés. Alapból KIKAPCSOLVA, mert az Apple push szolgáltatásához
# APNs-kulcs kell (fejlesztői tagsághoz kötött), ami még nincs meg. Amíg hamis,
# az app iOS-en csendben nem regisztrál push tokent — engedélyt sem kér.
# Androidot NEM érinti: ott a push a kulcs nélkül is működik.
EXPO_PUBLIC_PUSH_IOS_ENABLED=false
