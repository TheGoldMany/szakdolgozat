{
  "name": "menhely-adoptios-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma generate --schema=prisma/dwh.prisma && prisma db push --accept-data-loss && (prisma db push --schema=prisma/dwh.prisma --accept-data-loss || echo '⚠️  DWH db push skipped (unreachable) — continuing build') && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=guest",
    "test:e2e:admin": "playwright test --project=setup --project=admin",
    "test:e2e:all": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "prisma:seed:demo": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-demo.ts",
    "db:reset": "prisma migrate reset --force && npm run prisma:seed",
    "dwh:generate": "prisma generate --schema=prisma/dwh.prisma",
    "dwh:push": "prisma db push --schema=prisma/dwh.prisma --accept-data-loss"
  },
  "prisma": {
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@hookform/resolvers": "^3.3.4",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.13.0",
    "@react-leaflet/core": "^2.1.0",
    "@react-pdf/renderer": "^4.5.1",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^8.0.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.378.0",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "next-intl": "^4.9.1",
    "nodemailer": "^7.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.3",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.8.1",
    "sharp": "^0.33.3",
    "stripe": "^22.0.1",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.38",
    "prisma": "^5.13.0",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8"
  }
}
