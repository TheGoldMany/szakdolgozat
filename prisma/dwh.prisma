// -------------------------------------------------------
// Data Warehouse Schema – Csillag séma
// Külön Neon adatbázis (DWH_DATABASE_URL)
// -------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/dwh-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("dwh_POSTGRES_PRISMA_URL")
  directUrl = env("dwh_POSTGRES_URL_NON_POOLING")
}

// -------------------------------------------------------
// Dimenzió táblák
// -------------------------------------------------------

model DimDate {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  year      Int
  month     Int
  monthName String
  day       Int
  quarter   Int
  dayOfWeek Int
  isWeekend Boolean
  isHoliday Boolean  @default(false)

  factAdoptions FactAdoption[]
  factInventory FactAnimalInventory[]
}

model DimShelter {
  id         Int     @id @default(autoincrement())
  shelterId  String  @unique
  name       String
  city       String
  country    String  @default("HU")
  isVerified Boolean @default(false)

  dimAnimals    DimAnimal[]
  factAdoptions FactAdoption[]
  factInventory FactAnimalInventory[]
}

model DimAnimal {
  id          Int        @id @default(autoincrement())
  animalId    String     @unique
  name        String
  type        String
  breed       String?
  size        String?
  gender      String?
  ageCategory String?    // PUPPY / YOUNG / ADULT / SENIOR
  shelterId   Int
  shelter     DimShelter @relation(fields: [shelterId], references: [id])

  factAdoptions FactAdoption[]
}

model DimUser {
  id      Int     @id @default(autoincrement())
  userId  String  @unique
  city    String?
  country String  @default("HU")
  role    String  @default("USER")

  factAdoptions FactAdoption[]
}

// -------------------------------------------------------
// Tény táblák
// -------------------------------------------------------

model FactAdoption {
  id               Int        @id @default(autoincrement())
  applicationId    String     @unique
  dateId           Int
  date             DimDate    @relation(fields: [dateId], references: [id])
  animalId         Int
  animal           DimAnimal  @relation(fields: [animalId], references: [id])
  shelterId        Int
  shelter          DimShelter @relation(fields: [shelterId], references: [id])
  userId           Int
  user             DimUser    @relation(fields: [userId], references: [id])
  status           String
  stayDurationDays Int?
  applicationCount Int        @default(1)
  isReturn         Boolean    @default(false)
  homeType         String?
  hasGarden        Boolean?
  hasChildren      Boolean?
  hasPets          Boolean?
  createdAt        DateTime
  reviewedAt       DateTime?

  @@index([dateId])
  @@index([shelterId])
  @@index([animalId])
  @@index([status])
}

// -------------------------------------------------------
// ETL futásnapló
// -------------------------------------------------------

model EtlRun {
  id             Int      @id @default(autoincrement())
  startedAt      DateTime
  finishedAt     DateTime
  elapsedMs      Int
  adoptionCount  Int
  inventoryCount Int
  log            String   @db.Text
}

// Napi állomány-pillanatkép menhelyenként és státuszonként
model FactAnimalInventory {
  id        Int        @id @default(autoincrement())
  dateId    Int
  date      DimDate    @relation(fields: [dateId], references: [id])
  shelterId Int
  shelter   DimShelter @relation(fields: [shelterId], references: [id])
  status    String
  count     Int

  @@unique([dateId, shelterId, status])
  @@index([dateId])
  @@index([shelterId])
}
