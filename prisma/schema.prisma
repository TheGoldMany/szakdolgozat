// -------------------------------------------------------
// Prisma Schema – Menhely Adoptios Platform
// -------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------
// Enums
// -------------------------------------------------------

enum Role {
  USER
  SHELTER_ADMIN
  SUPER_ADMIN
}

enum AnimalType {
  DOG
  CAT
  RABBIT
  BIRD
  OTHER
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum AnimalStatus {
  AVAILABLE
  PENDING
  ADOPTED
  FOSTER
  MEDICAL_HOLD
}

enum ApplicationStatus {
  INVITED
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum InventoryCategory {
  FOOD       // Takarmány
  MEDICINE   // Gyógyszer
  SUPPLIES   // Kellékek
  CLEANING   // Tisztítószer
  EQUIPMENT  // Eszköz / felszerelés
  OTHER      // Egyéb
}

enum InventoryTxType {
  IN     // Bevételezés
  OUT    // Felhasználás
  ADJUST // Leltári korrekció (tényleges értékre állít)
}

enum FieldType {
  TEXT
  TEXTAREA
  IMAGE
  FILE
}

enum FormStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// -------------------------------------------------------
// User
// -------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  phone         String?
  address       String?
  city          String?
  country       String    @default("HU")
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  applications  AdoptionApplication[]
  shelterAdmins ShelterAdmin[]
  favorites     Favorite[]
  reports       AnimalReport[]
  conversations       Conversation[]        @relation("ConversationUser")
  sentMessages        Message[]             @relation("MessageSender")
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  donations           Donation[]            @relation("DonationUser")
  campaigns           Campaign[]            @relation("CampaignCreator")
  reviewsWritten      Review[]              @relation("ReviewAuthor")
  reviewsReceived     Review[]              @relation("ReviewTarget")
  healthRecordsAdded  HealthRecord[]        @relation("HealthRecordCreator")
  appointments        Appointment[]
  volunteering        Volunteer[]
  notifications       Notification[]
  inventoryTxs        InventoryTransaction[] @relation("InventoryTxCreator")
  behaviorLogsAdded   BehaviorLog[]          @relation("BehaviorLogAuthor")
  fosterProfiles      FosterProfile[]
  fosterSupplyLogs    FosterSupplyLog[]      @relation("FosterSupplyCreator")
}

// -------------------------------------------------------
// Password Reset
// -------------------------------------------------------

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------
// NextAuth models
// -------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------------------------
// Shelter (Menhely)
// -------------------------------------------------------

model Shelter {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  address     String
  city        String
  zipCode     String?
  country     String   @default("HU")
  phone       String?
  email       String?
  website     String?
  logoUrl          String?
  coverUrl         String?
  isVerified       Boolean  @default(false)
  isActive         Boolean  @default(true)
  lat              Float?
  lng              Float?
  // Fizetési / cégadatok
  companyName      String?
  taxNumber        String?
  bankAccountName  String?
  bankAccountNumber String?
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)
  capacity    Int?     // férőhelyek száma (UC-02 kapacitáskihasználtság)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  animals              Animal[]
  admins               ShelterAdmin[]
  conversations        Conversation[]
  documents            ShelterDocument[]
  adoptionRequirements String?            @db.Text
  tiers                DonationTier[]
  campaigns            Campaign[]
  applicationForms     ApplicationForm[]
  reviews              Review[]
  appointments         Appointment[]
  volunteers           Volunteer[]
  volunteerTasks       VolunteerTask[]
  inventoryItems       InventoryItem[]
  kennels              Kennel[]
  fosterProfiles       FosterProfile[]
}

model ShelterDocument {
  id        String   @id @default(cuid())
  shelterId String
  name      String
  url       String
  fileType  String   @default("application/pdf")
  createdAt DateTime @default(now())

  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)
}

model ShelterAdmin {
  id        String   @id @default(cuid())
  userId    String
  shelterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)

  @@unique([userId, shelterId])
}

// -------------------------------------------------------
// Animal (Állat)
// -------------------------------------------------------

model Animal {
  id             String       @id @default(cuid())
  shelterId      String
  name           String
  slug           String       @unique
  type           AnimalType
  breed          String?
  age            Int?          // hónapokban
  size           AnimalSize?
  gender         String?       // "MALE" | "FEMALE" | "UNKNOWN"
  color          String?
  weight         Float?        // kg
  description    String?      @db.Text
  isVaccinated   Boolean      @default(false)
  isNeutered     Boolean      @default(false)
  isMicrochipped Boolean      @default(false)
  isGoodWithKids Boolean?
  isGoodWithDogs Boolean?
  isGoodWithCats Boolean?
  status         AnimalStatus @default(AVAILABLE)
  flags          AnimalFlag[] @default([])  // belső, csak adminoknak látható kockázati címkék
  progressLevel  Int?                       // szubjektív rehabilitációs fejlődési szint (0-100)
  kennelId       String?                    // fizikai férőhely a menhelyen belül
  fosterId       String?                    // ideiglenes befogadó, akinél az állat fizikailag van
  arrivedAt      DateTime?
  adoptedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shelter       Shelter               @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  kennel        Kennel?               @relation(fields: [kennelId], references: [id], onDelete: SetNull)
  foster        FosterProfile?        @relation(fields: [fosterId], references: [id], onDelete: SetNull)
  images        AnimalImage[]
  documents     AnimalDocument[]
  applications  AdoptionApplication[]
  favorites     Favorite[]
  conversations Conversation[]
  healthRecords HealthRecord[]
  appointments  Appointment[]
  behaviorLogs  BehaviorLog[]

  @@index([kennelId])
  @@index([fosterId])
}

// -------------------------------------------------------
// Kennel (Férőhely / Kennel / Karantén / Macskaszoba)
// -------------------------------------------------------

enum KennelType {
  KENNEL      // Kennel (kutya)
  CAT_ROOM    // Macskaszoba
  QUARANTINE  // Karantén
  AVIARY      // Madárház / röpde
  OUTDOOR     // Kültéri kifutó
  OTHER       // Egyéb
}

model Kennel {
  id        String     @id @default(cuid())
  shelterId String
  shelter   Shelter    @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  name      String
  type      KennelType @default(KENNEL)
  capacity  Int        @default(1)  // maximális férőhely
  note      String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  animals   Animal[]

  @@index([shelterId])
}

// -------------------------------------------------------
// Behavior & Rehabilitation (Viselkedési és rehabilitációs napló)
// -------------------------------------------------------

enum AnimalFlag {
  ESCAPE_ARTIST            // Szökőművész
  FOOD_AGGRESSIVE          // Élelemirigy
  NOT_GOOD_WITH_CHILDREN   // Gyerekekkel nem barátságos
  NOT_GOOD_WITH_DOGS       // Kutyákkal nem barátságos
  NOT_GOOD_WITH_CATS       // Macskákkal nem barátságos
  NEEDS_EXPERIENCED_OWNER  // Tapasztalt gazdát igényel
  REACTIVE                 // Reaktív / ingerlékeny
  ANXIOUS                  // Szorongó
  MEDICAL_NEEDS            // Speciális orvosi ellátást igényel
  NO_APARTMENT             // Lakásba nem ajánlott (kert szükséges)
}

model BehaviorLog {
  id            String   @id @default(cuid())
  animalId      String
  animal        Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  note          String   @db.Text
  progressLevel Int?     // ehhez a bejegyzéshez tartozó fejlődési pillanatkép (0-100)
  authorId      String?
  author        User?    @relation("BehaviorLogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([animalId, createdAt])
}

model AnimalDocument {
  id        String   @id @default(cuid())
  animalId  String
  name      String
  url       String
  fileType  String   @default("application/pdf")
  sizeBytes Int?
  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
}

model AnimalImage {
  id        String   @id @default(cuid())
  animalId  String
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------
// Adoption Application (Örökbefogadási kérelem)
// -------------------------------------------------------

model AdoptionApplication {
  id           String            @id @default(cuid())
  userId       String
  animalId     String
  formId       String?
  inviteToken  String?           @unique
  status       ApplicationStatus @default(PENDING)
  message      String?           @db.Text
  homeType     String?           // "HOUSE" | "APARTMENT" | "OTHER"
  hasGarden    Boolean?
  hasChildren  Boolean?
  hasPets      Boolean?
  experience   String?           @db.Text
  reviewNotes  String?           @db.Text
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal    Animal           @relation(fields: [animalId], references: [id], onDelete: Cascade)
  form      ApplicationForm? @relation(fields: [formId], references: [id], onDelete: SetNull)
  responses FormFieldResponse[]
  followUps AdoptionFollowUp[]

  @@unique([userId, animalId])
  @@index([inviteToken])
}

model AdoptionFollowUp {
  id            String         @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  completedAt   DateTime?
  wellbeing     Int?           // 1-5 csillag
  notes         String?        @db.Text
  photoUrl      String?
  status        FollowUpStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  application AdoptionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status, scheduledAt])
}

// -------------------------------------------------------
// Favorite (Kedvencek)
// -------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  animalId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([userId, animalId])
}

// -------------------------------------------------------
// Animal Report (Elveszett / Megtalált / Kóbor bejelentés)
// -------------------------------------------------------

enum ReportType {
  LOST   // Elveszett
  FOUND  // Megtalált
  STRAY  // Kóbor
}

enum ReportStatus {
  ACTIVE   // Aktív
  RESOLVED // Megoldva
  CLOSED   // Lezárt
}

model AnimalReport {
  id           String       @id @default(cuid())
  userId       String?
  type         ReportType
  animalType   AnimalType
  name         String?
  breed        String?
  color        String?
  gender       String?
  description  String       @db.Text
  city         String
  address      String?
  lat          Float?
  lng          Float?
  imageUrl     String?
  contactName  String
  contactPhone String?
  contactEmail String
  status       ReportStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([city])
  @@index([animalType])
}

// -------------------------------------------------------
// Conversation / Chat
// -------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  animalId  String
  userId    String
  shelterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animal   Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  user     User      @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  shelter  Shelter   @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([animalId, userId])
  @@index([userId])
  @@index([shelterId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String?   @db.Text
  attachmentUrl  String?
  attachmentName String?
  readAt         DateTime?
  type           String    @default("TEXT")
  inviteToken    String?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------
// Donation System
// -------------------------------------------------------

enum CampaignStatus {
  PENDING
  ACTIVE
  COMPLETED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

model DonationTier {
  id          String   @id @default(cuid())
  shelterId   String
  name        String
  description String?  @db.Text
  amount      Int      // HUF / month
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shelter       Shelter        @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([shelterId])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  tierId      String
  status      SubscriptionStatus @default(ACTIVE)
  stripeSubId String?            @unique
  createdAt   DateTime           @default(now())
  cancelledAt DateTime?

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier DonationTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tierId])
}

model Campaign {
  id           String         @id @default(cuid())
  userId       String
  shelterId    String?
  title        String
  slug         String         @unique
  description  String         @db.Text
  targetAmount Int
  raisedAmount Int            @default(0)
  imageUrl     String?
  status       CampaignStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  endsAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user      User       @relation("CampaignCreator", fields: [userId], references: [id])
  shelter   Shelter?   @relation(fields: [shelterId], references: [id], onDelete: SetNull)
  donations Donation[]

  @@index([status])
  @@index([userId])
}

model Donation {
  id              String    @id @default(cuid())
  userId          String?
  campaignId      String?
  tierId          String?
  amount          Int
  message         String?   @db.Text
  isAnonymous     Boolean   @default(false)
  stripeSessionId String?   @unique
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  user     User?     @relation("DonationUser", fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
}

// -------------------------------------------------------
// Application Form System
// -------------------------------------------------------

model ApplicationForm {
  id          String     @id @default(cuid())
  shelterId   String
  shelter     Shelter    @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  title       String
  description String?    @db.Text
  status      FormStatus @default(DRAFT)
  fields      FormField[]
  applications AdoptionApplication[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([shelterId])
}

model FormField {
  id        String          @id @default(cuid())
  formId    String
  form      ApplicationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  label     String
  type      FieldType
  required  Boolean         @default(false)
  order     Int             @default(0)
  responses FormFieldResponse[]

  @@index([formId])
}

model FormFieldResponse {
  id            String              @id @default(cuid())
  applicationId String
  application   AdoptionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldId       String
  field         FormField           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value         String?             @db.Text
  fileUrl       String?

  @@index([applicationId])
}

// -------------------------------------------------------
// Reviews
// -------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Szerző (bejelentkezett user vagy shelter admin)
  authorId  String
  author    User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Értékelt menhely (user → shelter irány)
  shelterId String?
  shelter   Shelter? @relation(fields: [shelterId], references: [id], onDelete: Cascade)

  // Értékelt örökbefogadó (shelter → user irány)
  targetUserId String?
  targetUser   User?   @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([authorId, shelterId])        // user csak egyszer értékelheti a menhelyet
  @@unique([authorId, targetUserId])     // shelter csak egyszer értékelheti az örökbefogadót
  @@index([shelterId])
  @@index([targetUserId])
}

// -------------------------------------------------------
// Animal Health Records
// -------------------------------------------------------

enum AppointmentStatus {
  PENDING    // User requested, waiting for admin
  CONFIRMED  // Admin confirmed (with possible time adjustment)
  CANCELLED  // Cancelled by user or admin
  COMPLETED  // Meeting took place
}

enum HealthRecordType {
  VACCINATION
  TREATMENT
  VET_VISIT
  SURGERY
  DEWORMING
  CHECKUP
}

model HealthRecord {
  id          String           @id @default(cuid())
  animalId    String
  animal      Animal           @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type        HealthRecordType
  title       String
  description String?          @db.Text
  date        DateTime
  nextDueDate DateTime?
  vetName     String?
  createdById String?
  createdBy   User?            @relation("HealthRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([animalId])
  @@index([date])
}

// -------------------------------------------------------
// Appointment (Időpontfoglalás)
// -------------------------------------------------------

model Appointment {
  id          String            @id @default(cuid())
  shelterId   String
  shelter     Shelter           @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  animalId    String?
  animal      Animal?           @relation(fields: [animalId], references: [id], onDelete: SetNull)

  status      AppointmentStatus @default(PENDING)
  proposedAt  DateTime          // User's preferred date/time
  confirmedAt DateTime?         // Admin-set confirmed time (may differ from proposedAt)

  note        String?           @db.Text  // User's message to shelter
  adminNote   String?           @db.Text  // Admin's reply

  cancelledBy String?           // "USER" | "ADMIN"

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([shelterId])
  @@index([userId])
  @@index([animalId])
  @@index([status])
}

// -------------------------------------------------------
// Volunteer Management (Önkéntes kezelés)
// -------------------------------------------------------

enum VolunteerStatus {
  PENDING   // Jelentkezett, jóváhagyásra vár
  ACTIVE    // Visszaigazolt aktív önkéntes
  INACTIVE  // Inaktív
  REJECTED  // Elutasított
}

enum VolunteerTaskStatus {
  OPEN      // Nyitott feladat
  ASSIGNED  // Hozzárendelve
  COMPLETED // Elvégezve
  CANCELLED // Lemondva
}

model Volunteer {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelterId    String
  shelter      Shelter         @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  status       VolunteerStatus @default(PENDING)
  motivation   String?         @db.Text
  skills       String?
  availability String?
  adminNote    String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  attendances  VolunteerAttendance[]
  assignments  VolunteerTaskAssignment[]

  @@unique([userId, shelterId])
  @@index([shelterId])
  @@index([status])
}

model VolunteerTask {
  id            String              @id @default(cuid())
  shelterId     String
  shelter       Shelter             @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  title         String
  description   String?             @db.Text
  scheduledAt   DateTime
  maxVolunteers Int                 @default(1)
  status        VolunteerTaskStatus @default(OPEN)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  assignments   VolunteerTaskAssignment[]

  @@index([shelterId])
  @@index([status])
}

model VolunteerTaskAssignment {
  id          String        @id @default(cuid())
  taskId      String
  task        VolunteerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  volunteerId String
  volunteer   Volunteer     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([taskId, volunteerId])
  @@index([volunteerId])
}

model VolunteerAttendance {
  id          String    @id @default(cuid())
  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  date        DateTime
  hours       Float     @default(1)
  note        String?
  createdAt   DateTime  @default(now())

  @@index([volunteerId])
}

// -------------------------------------------------------
// Notifications (Értesítések)
// -------------------------------------------------------

enum NotificationType {
  // Appointment
  APPOINTMENT_NEW          // Admin: new booking request
  APPOINTMENT_CONFIRMED    // User: admin confirmed
  APPOINTMENT_CANCELLED    // User/admin: cancelled
  // Adoption application
  APPLICATION_SUBMITTED    // Admin: new application submitted
  APPLICATION_REVIEWING    // User: application under review
  APPLICATION_APPROVED     // User: application approved
  APPLICATION_REJECTED     // User: application rejected
  // Volunteer
  VOLUNTEER_NEW            // Admin: new volunteer application
  VOLUNTEER_APPROVED       // User: volunteer application approved
  VOLUNTEER_REJECTED       // User: volunteer application rejected
  TASK_SIGNUP              // Admin: volunteer signed up for a task
  // Foster (ideiglenes befogadó)
  FOSTER_NEW               // Admin: new foster application
  FOSTER_APPROVED          // User: foster application approved
  FOSTER_REJECTED          // User: foster application rejected
  FOSTER_PLACEMENT         // User: an animal was placed in their care
  // Campaigns
  CAMPAIGN_PENDING         // Super admin: campaign awaiting approval
  CAMPAIGN_APPROVED        // Owner: campaign approved
  CAMPAIGN_REJECTED        // Owner: campaign rejected
  // Application forms
  FORM_PENDING_APPROVAL    // Super admin: form awaiting approval
  FORM_APPROVED            // Shelter admin: form approved
  FORM_REJECTED            // Shelter admin: form rejected
  // Reports
  REPORT_RESOLVED          // User: report status updated
  // Donations & subscriptions
  DONATION_RECEIVED        // Admin: new donation received
  SUBSCRIPTION_STARTED     // User: subscription confirmed
  SUBSCRIPTION_CANCELLED   // User: subscription cancelled
  // Messages
  NEW_MESSAGE              // User/admin: new unread message
  // Follow-up
  FOLLOW_UP_DUE            // User: follow-up questionnaire due
  FOLLOW_UP_RECEIVED       // Admin: user submitted a follow-up
  // Inventory
  INVENTORY_LOW_STOCK      // Admin: item quantity fell below minimum
  INVENTORY_EXPIRING_SOON  // Admin: item expiring within 7 days
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  href      String?          // Deep-link to the relevant page
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// -------------------------------------------------------
// Inventory (Készletkezelés)
// -------------------------------------------------------

model InventoryItem {
  id          String            @id @default(cuid())
  shelterId   String
  shelter     Shelter           @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  name        String
  category    InventoryCategory @default(OTHER)
  unit        String            @default("db")  // "kg", "liter", "db", stb.
  quantity    Float             @default(0)      // aktuális készlet
  minQuantity Float?                             // riasztási küszöb
  expiresAt   DateTime?                          // szavatossági dátum
  note        String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  transactions InventoryTransaction[]
  fosterSupplyLogs FosterSupplyLog[]

  @@index([shelterId])
  @@index([category])
}

model InventoryTransaction {
  id          String          @id @default(cuid())
  itemId      String
  item        InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        InventoryTxType
  // delta: pozitív = növekedés, negatív = csökkenés (ADJUST esetén is a valós eltérés)
  quantity    Float
  note        String?
  createdById String?
  createdBy   User?           @relation("InventoryTxCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([itemId])
  @@index([createdAt])
}

// -------------------------------------------------------
// Foster (Ideiglenes befogadó)
// -------------------------------------------------------

enum FosterStatus {
  PENDING   // Jelentkezett, jóváhagyásra vár
  ACTIVE    // Aktív, visszaigazolt ideiglenes befogadó
  INACTIVE  // Inaktív
  REJECTED  // Elutasított
}

model FosterProfile {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelterId      String
  shelter        Shelter      @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  status         FosterStatus @default(PENDING)
  preferredTypes AnimalType[] @default([])  // milyen állatot fogadna (üres = bármi)
  maxWeightKg    Float?                      // maximális súly, amit vállal
  canQuarantine  Boolean      @default(false) // tud-e karantént / izolációt biztosítani
  motivation     String?      @db.Text
  adminNote      String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  fosteredAnimals Animal[]
  supplyLogs      FosterSupplyLog[]

  @@unique([userId, shelterId])
  @@index([shelterId])
  @@index([status])
}

model FosterSupplyLog {
  id          String        @id @default(cuid())
  fosterId    String
  foster      FosterProfile @relation(fields: [fosterId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Float         // kiadott mennyiség (a központi készletből levonva)
  note        String?
  createdById String?
  createdBy   User?         @relation("FosterSupplyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([fosterId])
  @@index([itemId])
}
