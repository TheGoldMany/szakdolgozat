// -------------------------------------------------------
// Prisma Schema – Menhely Adoptios Platform
// -------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------
// Enums
// -------------------------------------------------------

enum Role {
  USER
  SHELTER_ADMIN
  SUPER_ADMIN
}

enum AnimalType {
  DOG
  CAT
  RABBIT
  BIRD
  OTHER
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum AnimalStatus {
  AVAILABLE
  PENDING
  ADOPTED
  FOSTER
  MEDICAL_HOLD
}

enum ApplicationStatus {
  INVITED
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum InventoryCategory {
  FOOD // Takarmány
  MEDICINE // Gyógyszer
  SUPPLIES // Kellékek
  CLEANING // Tisztítószer
  EQUIPMENT // Eszköz / felszerelés
  OTHER // Egyéb
}

enum InventoryTxType {
  IN // Bevételezés
  OUT // Felhasználás
  ADJUST // Leltári korrekció (tényleges értékre állít)
}

enum FieldType {
  TEXT
  TEXTAREA
  IMAGE
  FILE
}

enum FormStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// -------------------------------------------------------
// User
// -------------------------------------------------------

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String    @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  role                     Role      @default(USER)
  phone                    String?
  address                  String?
  city                     String?
  country                  String    @default("HU")
  stripeAccountId          String?
  stripeOnboardingComplete Boolean   @default(false)
  birthDate                DateTime?
  deletionScheduledAt      DateTime?
  emailNotifications       Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  applications        AdoptionApplication[]
  shelterAdmins       ShelterAdmin[]
  favorites           Favorite[]
  reports             AnimalReport[]
  conversations       Conversation[]         @relation("ConversationUser")
  sentMessages        Message[]              @relation("MessageSender")
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  donations           Donation[]             @relation("DonationUser")
  campaigns           Campaign[]             @relation("CampaignCreator")
  reviewsWritten      Review[]               @relation("ReviewAuthor")
  reviewsReceived     Review[]               @relation("ReviewTarget")
  healthRecordsAdded  HealthRecord[]         @relation("HealthRecordCreator")
  appointments        Appointment[]
  volunteering        Volunteer[]
  notifications       Notification[]
  inventoryTxs        InventoryTransaction[] @relation("InventoryTxCreator")
  behaviorLogsAdded   BehaviorLog[]          @relation("BehaviorLogAuthor")
  fosterProfiles      FosterProfile[]
  fosterSupplyLogs    FosterSupplyLog[]      @relation("FosterSupplyCreator")
  sponsorships        Sponsorship[]
  eventRegistrations  EventRegistration[]
  transferRequests    AnimalTransfer[]       @relation("TransferRequester")
  transferResolutions AnimalTransfer[]       @relation("TransferResolver")
  posts               Post[]                 @relation("PostAuthor")
  postLikes           PostLike[]
}

// -------------------------------------------------------
// Password Reset
// -------------------------------------------------------

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------
// NextAuth models
// -------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------------------------
// Shelter (Menhely)
// -------------------------------------------------------

model Shelter {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  description              String?  @db.Text
  address                  String
  city                     String
  zipCode                  String?
  country                  String   @default("HU")
  phone                    String?
  email                    String?
  website                  String?
  logoUrl                  String?
  coverUrl                 String?
  isVerified               Boolean  @default(false)
  isActive                 Boolean  @default(true)
  lat                      Float?
  lng                      Float?
  // Fizetési / cégadatok
  companyName              String?
  taxNumber                String?
  bankAccountName          String?
  bankAccountNumber        String?
  stripeAccountId          String?
  stripeOnboardingComplete Boolean  @default(false)
  capacity                 Int? // férőhelyek száma (UC-02 kapacitáskihasználtság)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  animals              Animal[]
  admins               ShelterAdmin[]
  conversations        Conversation[]
  documents            ShelterDocument[]
  adoptionRequirements String?           @db.Text
  tiers                DonationTier[]
  campaigns            Campaign[]
  applicationForms     ApplicationForm[]
  reviews              Review[]
  appointments         Appointment[]
  volunteers           Volunteer[]
  volunteerTasks       VolunteerTask[]
  inventoryItems       InventoryItem[]
  kennels              Kennel[]
  fosterProfiles       FosterProfile[]
  events               Event[]
  transfersFrom        AnimalTransfer[]  @relation("TransferFrom")
  transfersTo          AnimalTransfer[]  @relation("TransferTo")
  feedingSchedules     FeedingSchedule[]
  posts                Post[]
}

model ShelterDocument {
  id        String   @id @default(cuid())
  shelterId String
  name      String
  url       String
  fileType  String   @default("application/pdf")
  createdAt DateTime @default(now())

  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)
}

model ShelterAdmin {
  id        String   @id @default(cuid())
  userId    String
  shelterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)

  @@unique([userId, shelterId])
}

// -------------------------------------------------------
// Animal (Állat)
// -------------------------------------------------------

model Animal {
  id             String       @id @default(cuid())
  shelterId      String
  name           String
  slug           String       @unique
  type           AnimalType
  breed          String?
  age            Int? // hónapokban
  size           AnimalSize?
  gender         String? // "MALE" | "FEMALE" | "UNKNOWN"
  color          String?
  weight         Float? // kg
  description    String?      @db.Text
  isVaccinated   Boolean      @default(false)
  isNeutered     Boolean      @default(false)
  isMicrochipped Boolean      @default(false)
  isGoodWithKids Boolean?
  isGoodWithDogs Boolean?
  isGoodWithCats Boolean?
  status         AnimalStatus @default(AVAILABLE)
  flags          AnimalFlag[] @default([]) // belső, csak adminoknak látható kockázati címkék
  progressLevel  Int? // szubjektív rehabilitációs fejlődési szint (0-100)
  kennelId       String? // fizikai férőhely a menhelyen belül
  fosterId       String? // ideiglenes befogadó, akinél az állat fizikailag van
  arrivedAt      DateTime?
  adoptedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shelter       Shelter               @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  kennel        Kennel?               @relation(fields: [kennelId], references: [id], onDelete: SetNull)
  foster        FosterProfile?        @relation(fields: [fosterId], references: [id], onDelete: SetNull)
  images        AnimalImage[]
  documents     AnimalDocument[]
  applications  AdoptionApplication[]
  favorites     Favorite[]
  conversations Conversation[]
  healthRecords HealthRecord[]
  appointments  Appointment[]
  behaviorLogs  BehaviorLog[]
  sponsorships  Sponsorship[]
  transfers     AnimalTransfer[]
  posts         Post[]

  @@index([kennelId])
  @@index([fosterId])
  @@index([status])
  @@index([shelterId, status])
  @@index([type, status])
}

// -------------------------------------------------------
// Sponsorship / Virtual Adoption (Virtuális örökbefogadás)
// -------------------------------------------------------

model Sponsorship {
  id          String             @id @default(cuid())
  animalId    String
  animal      Animal             @relation(fields: [animalId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount      Int // havi támogatás (HUF)
  isPublic    Boolean            @default(true) // megjelenjen-e „Virtuális gazdi”-ként
  displayName String? // opcionális publikus név (ha null és isPublic → user neve)
  status      SubscriptionStatus @default(ACTIVE)
  stripeSubId String?            @unique
  createdAt   DateTime           @default(now())
  cancelledAt DateTime?

  @@index([animalId, status])
  @@index([userId])
}

// -------------------------------------------------------
// Kennel (Férőhely / Kennel / Karantén / Macskaszoba)
// -------------------------------------------------------

enum KennelType {
  KENNEL // Kennel (kutya)
  CAT_ROOM // Macskaszoba
  QUARANTINE // Karantén
  AVIARY // Madárház / röpde
  OUTDOOR // Kültéri kifutó
  OTHER // Egyéb
}

model Kennel {
  id        String     @id @default(cuid())
  shelterId String
  shelter   Shelter    @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  name      String
  type      KennelType @default(KENNEL)
  capacity  Int        @default(1) // maximális férőhely
  note      String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  animals Animal[]

  @@index([shelterId])
}

// -------------------------------------------------------
// Behavior & Rehabilitation (Viselkedési és rehabilitációs napló)
// -------------------------------------------------------

enum AnimalFlag {
  ESCAPE_ARTIST // Szökőművész
  FOOD_AGGRESSIVE // Élelemirigy
  NOT_GOOD_WITH_CHILDREN // Gyerekekkel nem barátságos
  NOT_GOOD_WITH_DOGS // Kutyákkal nem barátságos
  NOT_GOOD_WITH_CATS // Macskákkal nem barátságos
  NEEDS_EXPERIENCED_OWNER // Tapasztalt gazdát igényel
  REACTIVE // Reaktív / ingerlékeny
  ANXIOUS // Szorongó
  MEDICAL_NEEDS // Speciális orvosi ellátást igényel
  NO_APARTMENT // Lakásba nem ajánlott (kert szükséges)
}

model BehaviorLog {
  id            String   @id @default(cuid())
  animalId      String
  animal        Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  note          String   @db.Text
  progressLevel Int? // ehhez a bejegyzéshez tartozó fejlődési pillanatkép (0-100)
  authorId      String?
  author        User?    @relation("BehaviorLogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([animalId, createdAt])
}

model AnimalDocument {
  id        String   @id @default(cuid())
  animalId  String
  name      String
  url       String
  fileType  String   @default("application/pdf")
  sizeBytes Int?
  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
}

model AnimalImage {
  id        String   @id @default(cuid())
  animalId  String
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------
// Adoption Application (Örökbefogadási kérelem)
// -------------------------------------------------------

model AdoptionApplication {
  id          String            @id @default(cuid())
  userId      String
  animalId    String
  formId      String?
  inviteToken String?           @unique
  status      ApplicationStatus @default(PENDING)
  message     String?           @db.Text
  homeType    String? // "HOUSE" | "APARTMENT" | "OTHER"
  hasGarden   Boolean?
  hasChildren Boolean?
  hasPets     Boolean?
  experience  String?           @db.Text
  reviewNotes String?           @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal    Animal              @relation(fields: [animalId], references: [id], onDelete: Cascade)
  form      ApplicationForm?    @relation(fields: [formId], references: [id], onDelete: SetNull)
  responses FormFieldResponse[]
  followUps AdoptionFollowUp[]

  @@unique([userId, animalId])
  @@index([inviteToken])
  @@index([animalId])
  @@index([userId, status])
  @@index([status, createdAt])
}

model AdoptionFollowUp {
  id            String         @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  completedAt   DateTime?
  wellbeing     Int? // 1-5 csillag
  notes         String?        @db.Text
  photoUrl      String?
  status        FollowUpStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  application AdoptionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status, scheduledAt])
}

// -------------------------------------------------------
// Favorite (Kedvencek)
// -------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  animalId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([userId, animalId])
}

// -------------------------------------------------------
// Animal Report (Elveszett / Megtalált / Kóbor bejelentés)
// -------------------------------------------------------

enum ReportType {
  LOST // Elveszett
  FOUND // Megtalált
  STRAY // Kóbor
}

enum ReportStatus {
  ACTIVE // Aktív
  RESOLVED // Megoldva
  CLOSED // Lezárt
}

// Kép-alapú elveszett-talált párosítás eredménye
enum MatchVerdict {
  LIKELY // Valószínű egyezés
  POSSIBLE // Lehetséges egyezés
  UNLIKELY // Valószínűtlen
}

model AnimalReport {
  id           String       @id @default(cuid())
  userId       String?
  type         ReportType
  animalType   AnimalType
  name         String?
  breed        String?
  color        String?
  gender       String?
  description  String       @db.Text
  city         String
  address      String?
  lat          Float?
  lng          Float?
  imageUrl     String?
  contactName  String
  contactPhone String?
  contactEmail String
  status       ReportStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // AI kép-elemzés (Claude Vision) – strukturált leíró a párosításhoz
  aiAnalyzed     Boolean   @default(false)
  aiAnalyzedAt   DateTime?
  aiSpecies      String? // felismert faj
  aiBreed        String? // becsült fajta
  aiColors       String[] // domináns színek
  aiPattern      String? // mintázat (pl. cirmos, foltos)
  aiSize         String? // becsült méret
  aiFeatures     String[] // megkülönböztető jegyek
  aiHasCollar    Boolean?
  aiSummary      String?   @db.Text // rövid kereshető összefoglaló

  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  images    ReportImage[]
  matchesA  ReportMatch[] @relation("ReportMatchA")
  matchesB  ReportMatch[] @relation("ReportMatchB")

  @@index([type])
  @@index([status])
  @@index([city])
  @@index([animalType])
}

// Egy bejelentéshez tartozó képek (mint az AnimalImage az állatoknál).
// A primary kép URL-je denormalizálva az AnimalReport.imageUrl mezőben is.
model ReportImage {
  id        String       @id @default(cuid())
  reportId  String
  url       String
  alt       String?
  isPrimary Boolean      @default(false)
  order     Int          @default(0)
  createdAt DateTime     @default(now())

  report AnimalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// Két bejelentés (jellemzően egy LOST és egy FOUND/STRAY) közötti párosítás.
// reportA a "lekérdező" (általában az elveszett), reportB a jelölt.
model ReportMatch {
  id         String       @id @default(cuid())
  reportAId  String
  reportA    AnimalReport @relation("ReportMatchA", fields: [reportAId], references: [id], onDelete: Cascade)
  reportBId  String
  reportB    AnimalReport @relation("ReportMatchB", fields: [reportBId], references: [id], onDelete: Cascade)
  score      Float // 0..1 összesített pontszám
  verdict    MatchVerdict
  reasons    String[] // emberi nyelvű indoklás (magyar)
  distanceKm Float?
  daysApart  Int?
  dismissed  Boolean      @default(false) // "ez nem az" visszajelzés
  notified   Boolean      @default(false) // értesítő email kiment-e
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([reportAId, reportBId])
  @@index([reportAId])
  @@index([reportBId])
  @@index([verdict])
}

// -------------------------------------------------------
// Conversation / Chat
// -------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  animalId  String
  userId    String
  shelterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animal   Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  user     User      @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  shelter  Shelter   @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([animalId, userId])
  @@index([userId])
  @@index([shelterId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String?   @db.Text
  attachmentUrl  String?
  attachmentName String?
  readAt         DateTime?
  type           String    @default("TEXT")
  inviteToken    String?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, readAt])
  @@index([conversationId, createdAt])
}

// -------------------------------------------------------
// Donation System
// -------------------------------------------------------

enum CampaignStatus {
  PENDING
  ACTIVE
  COMPLETED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

model DonationTier {
  id          String   @id @default(cuid())
  shelterId   String
  name        String
  description String?  @db.Text
  amount      Int // HUF / month
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shelter       Shelter        @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([shelterId])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String?
  tierId      String
  status      SubscriptionStatus @default(ACTIVE)
  stripeSubId String?            @unique
  createdAt   DateTime           @default(now())
  cancelledAt DateTime?

  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  tier DonationTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tierId])
}

model Campaign {
  id           String         @id @default(cuid())
  userId       String?
  shelterId    String?
  title        String
  slug         String         @unique
  description  String         @db.Text
  targetAmount Int
  raisedAmount Int            @default(0)
  imageUrl     String?
  status       CampaignStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  endsAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user      User?      @relation("CampaignCreator", fields: [userId], references: [id], onDelete: SetNull)
  shelter   Shelter?   @relation(fields: [shelterId], references: [id], onDelete: SetNull)
  donations Donation[]
  posts     Post[]

  @@index([status])
  @@index([userId])
}

model Donation {
  id              String    @id @default(cuid())
  userId          String?
  campaignId      String?
  tierId          String?
  amount          Int
  message         String?   @db.Text
  isAnonymous     Boolean   @default(false)
  stripeSessionId String?   @unique
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  user     User?     @relation("DonationUser", fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
}

// -------------------------------------------------------
// Application Form System
// -------------------------------------------------------

model ApplicationForm {
  id           String                @id @default(cuid())
  shelterId    String
  shelter      Shelter               @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  title        String
  description  String?               @db.Text
  status       FormStatus            @default(DRAFT)
  fields       FormField[]
  applications AdoptionApplication[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([shelterId])
}

model FormField {
  id        String              @id @default(cuid())
  formId    String
  form      ApplicationForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  label     String
  type      FieldType
  required  Boolean             @default(false)
  order     Int                 @default(0)
  responses FormFieldResponse[]

  @@index([formId])
}

model FormFieldResponse {
  id            String              @id @default(cuid())
  applicationId String
  application   AdoptionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldId       String
  field         FormField           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value         String?             @db.Text
  fileUrl       String?

  @@index([applicationId])
}

// -------------------------------------------------------
// Reviews
// -------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Szerző (bejelentkezett user vagy shelter admin)
  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Értékelt menhely (user → shelter irány)
  shelterId String?
  shelter   Shelter? @relation(fields: [shelterId], references: [id], onDelete: Cascade)

  // Értékelt örökbefogadó (shelter → user irány)
  targetUserId String?
  targetUser   User?   @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([authorId, shelterId]) // user csak egyszer értékelheti a menhelyet
  @@unique([authorId, targetUserId]) // shelter csak egyszer értékelheti az örökbefogadót
  @@index([shelterId])
  @@index([targetUserId])
}

// -------------------------------------------------------
// Animal Health Records
// -------------------------------------------------------

enum AppointmentStatus {
  PENDING // User requested, waiting for admin
  CONFIRMED // Admin confirmed (with possible time adjustment)
  CANCELLED // Cancelled by user or admin
  COMPLETED // Meeting took place
}

enum HealthRecordType {
  VACCINATION
  TREATMENT
  VET_VISIT
  SURGERY
  DEWORMING
  CHECKUP
}

model HealthRecord {
  id          String           @id @default(cuid())
  animalId    String
  animal      Animal           @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type        HealthRecordType
  title       String
  description String?          @db.Text
  date        DateTime
  nextDueDate DateTime?
  vetName     String?
  createdById String?
  createdBy   User?            @relation("HealthRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([animalId])
  @@index([date])
}

// -------------------------------------------------------
// Appointment (Időpontfoglalás)
// -------------------------------------------------------

model Appointment {
  id        String  @id @default(cuid())
  shelterId String
  shelter   Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  animalId  String?
  animal    Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)

  status      AppointmentStatus @default(PENDING)
  proposedAt  DateTime // User's preferred date/time
  confirmedAt DateTime? // Admin-set confirmed time (may differ from proposedAt)

  note      String? @db.Text // User's message to shelter
  adminNote String? @db.Text // Admin's reply

  cancelledBy String? // "USER" | "ADMIN"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shelterId])
  @@index([userId])
  @@index([animalId])
  @@index([status])
}

// -------------------------------------------------------
// Volunteer Management (Önkéntes kezelés)
// -------------------------------------------------------

enum VolunteerStatus {
  PENDING // Jelentkezett, jóváhagyásra vár
  ACTIVE // Visszaigazolt aktív önkéntes
  INACTIVE // Inaktív
  REJECTED // Elutasított
}

enum VolunteerTaskStatus {
  OPEN // Nyitott feladat
  ASSIGNED // Hozzárendelve
  COMPLETED // Elvégezve
  CANCELLED // Lemondva
}

model Volunteer {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelterId    String
  shelter      Shelter         @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  status       VolunteerStatus @default(PENDING)
  motivation   String?         @db.Text
  skills       String?
  availability String?
  adminNote    String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  attendances VolunteerAttendance[]
  assignments VolunteerTaskAssignment[]

  @@unique([userId, shelterId])
  @@index([shelterId])
  @@index([status])
}

model VolunteerTask {
  id            String              @id @default(cuid())
  shelterId     String
  shelter       Shelter             @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  title         String
  description   String?             @db.Text
  scheduledAt   DateTime
  maxVolunteers Int                 @default(1)
  status        VolunteerTaskStatus @default(OPEN)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  assignments VolunteerTaskAssignment[]

  @@index([shelterId])
  @@index([status])
}

model VolunteerTaskAssignment {
  id          String        @id @default(cuid())
  taskId      String
  task        VolunteerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  volunteerId String
  volunteer   Volunteer     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([taskId, volunteerId])
  @@index([volunteerId])
}

model VolunteerAttendance {
  id          String    @id @default(cuid())
  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  date        DateTime
  hours       Float     @default(1)
  note        String?
  createdAt   DateTime  @default(now())

  @@index([volunteerId])
}

// -------------------------------------------------------
// Notifications (Értesítések)
// -------------------------------------------------------

enum NotificationType {
  // Appointment
  APPOINTMENT_NEW // Admin: new booking request
  APPOINTMENT_CONFIRMED // User: admin confirmed
  APPOINTMENT_CANCELLED // User/admin: cancelled
  // Adoption application
  APPLICATION_SUBMITTED // Admin: new application submitted
  APPLICATION_REVIEWING // User: application under review
  APPLICATION_APPROVED // User: application approved
  APPLICATION_REJECTED // User: application rejected
  // Volunteer
  VOLUNTEER_NEW // Admin: new volunteer application
  VOLUNTEER_APPROVED // User: volunteer application approved
  VOLUNTEER_REJECTED // User: volunteer application rejected
  TASK_SIGNUP // Admin: volunteer signed up for a task
  // Foster (ideiglenes befogadó)
  FOSTER_NEW // Admin: new foster application
  FOSTER_APPROVED // User: foster application approved
  FOSTER_REJECTED // User: foster application rejected
  FOSTER_PLACEMENT // User: an animal was placed in their care
  // Campaigns
  CAMPAIGN_PENDING // Super admin: campaign awaiting approval
  CAMPAIGN_APPROVED // Owner: campaign approved
  CAMPAIGN_REJECTED // Owner: campaign rejected
  // Application forms
  FORM_PENDING_APPROVAL // Super admin: form awaiting approval
  FORM_APPROVED // Shelter admin: form approved
  FORM_REJECTED // Shelter admin: form rejected
  // Reports
  REPORT_RESOLVED // User: report status updated
  REPORT_MATCH_FOUND // User: a likely lost/found match was found for their report
  REPORT_NEARBY // Shelter admin: a stray animal was reported near the shelter
  // Donations & subscriptions
  DONATION_RECEIVED // Admin: new donation received
  SUBSCRIPTION_STARTED // User: subscription confirmed
  SUBSCRIPTION_CANCELLED // User: subscription cancelled
  // Virtual adoption / sponsorship
  SPONSORSHIP_STARTED // User: virtual adoption confirmed
  SPONSOR_UPDATE // Virtual owner: sponsored animal updated (health/photo/adopted)
  // Events (örökbefogadási nap / esemény)
  EVENT_REGISTRATION // Admin: new event registration
  EVENT_UPDATED // Registrant: event details changed
  EVENT_CANCELLED // Registrant: event was cancelled
  // Messages
  NEW_MESSAGE // User/admin: new unread message
  // Follow-up
  FOLLOW_UP_DUE // User: follow-up questionnaire due
  FOLLOW_UP_RECEIVED // Admin: user submitted a follow-up
  // Inventory
  INVENTORY_LOW_STOCK // Admin: item quantity fell below minimum
  INVENTORY_EXPIRING_SOON // Admin: item expiring within 7 days
  // Animal transfers (menhelyek közötti áthelyezés)
  TRANSFER_REQUESTED // Target shelter admin: new transfer request
  TRANSFER_APPROVED // Requester: transfer was approved
  TRANSFER_REJECTED // Requester: transfer was rejected
  // Shelter status (shelter admin)
  SHELTER_SUSPENDED    // Shelter admin: shelter suspended by super admin
  SHELTER_REACTIVATED  // Shelter admin: shelter reactivated by super admin
  SHELTER_DELETED      // Shelter admin: shelter deleted by super admin
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  href      String? // Deep-link to the relevant page
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// -------------------------------------------------------
// Inventory (Készletkezelés)
// -------------------------------------------------------

model InventoryItem {
  id          String            @id @default(cuid())
  shelterId   String
  shelter     Shelter           @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  name        String
  category    InventoryCategory @default(OTHER)
  unit        String            @default("db") // "kg", "liter", "db", stb.
  quantity    Float             @default(0) // aktuális készlet
  minQuantity Float? // riasztási küszöb
  expiresAt   DateTime? // szavatossági dátum
  note        String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  transactions     InventoryTransaction[]
  fosterSupplyLogs FosterSupplyLog[]
  feedingSchedules FeedingSchedule[]

  @@index([shelterId])
  @@index([category])
}

model InventoryTransaction {
  id          String          @id @default(cuid())
  itemId      String
  item        InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        InventoryTxType
  // delta: pozitív = növekedés, negatív = csökkenés (ADJUST esetén is a valós eltérés)
  quantity    Float
  note        String?
  createdById String?
  createdBy   User?           @relation("InventoryTxCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([itemId])
  @@index([createdAt])
}

// -------------------------------------------------------
// Foster (Ideiglenes befogadó)
// -------------------------------------------------------

enum FosterStatus {
  PENDING // Jelentkezett, jóváhagyásra vár
  ACTIVE // Aktív, visszaigazolt ideiglenes befogadó
  INACTIVE // Inaktív
  REJECTED // Elutasított
}

model FosterProfile {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelterId      String
  shelter        Shelter      @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  status         FosterStatus @default(PENDING)
  preferredTypes AnimalType[] @default([]) // milyen állatot fogadna (üres = bármi)
  maxWeightKg    Float? // maximális súly, amit vállal
  canQuarantine  Boolean      @default(false) // tud-e karantént / izolációt biztosítani
  motivation     String?      @db.Text
  adminNote      String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  fosteredAnimals Animal[]
  supplyLogs      FosterSupplyLog[]

  @@unique([userId, shelterId])
  @@index([shelterId])
  @@index([status])
}

model FosterSupplyLog {
  id          String        @id @default(cuid())
  fosterId    String
  foster      FosterProfile @relation(fields: [fosterId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Float // kiadott mennyiség (a központi készletből levonva)
  note        String?
  createdById String?
  createdBy   User?         @relation("FosterSupplyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([fosterId])
  @@index([itemId])
}

// -------------------------------------------------------
// Events (Örökbefogadási nap / esemény modul)
// -------------------------------------------------------

enum EventType {
  ADOPTION_DAY // Örökbefogadási nap
  FUNDRAISER // Adománygyűjtő esemény
  VOLUNTEER_DAY // Önkéntes nap
  OPEN_DAY // Nyílt nap
  EDUCATION // Oktatás / előadás
  OTHER // Egyéb
}

enum EventStatus {
  DRAFT // Vázlat, csak az admin látja
  PUBLISHED // Közzétéve, publikus
  CANCELLED // Lemondva
  COMPLETED // Lezárult
}

enum EventRegistrationStatus {
  REGISTERED // Jelentkezett
  CANCELLED // Lemondta
  ATTENDED // Megjelent (utólag jelölhető)
}

model Event {
  id          String      @id @default(cuid())
  shelterId   String
  shelter     Shelter     @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  title       String
  slug        String      @unique
  description String      @db.Text
  type        EventType   @default(ADOPTION_DAY)
  location    String
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int? // null = korlátlan
  imageUrl    String?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  registrations EventRegistration[]
  posts         Post[]

  @@index([shelterId])
  @@index([status, startsAt])
}

model EventRegistration {
  id        String                  @id @default(cuid())
  eventId   String
  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    EventRegistrationStatus @default(REGISTERED)
  guests    Int                     @default(0) // kísérők száma a jelentkezőn felül
  note      String?                 @db.Text
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// -------------------------------------------------------
// Animal Transfer (Menhelyek közötti áthelyezés)
// -------------------------------------------------------

enum TransferStatus {
  PENDING // Jóváhagyásra vár
  APPROVED // Jóváhagyva, áthelyezés megtörtént
  REJECTED // Elutasítva
  CANCELLED // Visszavonva a kérelmező által
}

model AnimalTransfer {
  id            String         @id @default(cuid())
  animalId      String
  animal        Animal         @relation(fields: [animalId], references: [id], onDelete: Cascade)
  fromShelterId String
  fromShelter   Shelter        @relation("TransferFrom", fields: [fromShelterId], references: [id], onDelete: Cascade)
  toShelterId   String
  toShelter     Shelter        @relation("TransferTo", fields: [toShelterId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User           @relation("TransferRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedById  String?
  resolvedBy    User?          @relation("TransferResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  status        TransferStatus @default(PENDING)
  note          String?        @db.Text
  requestedAt   DateTime       @default(now())
  resolvedAt    DateTime?

  @@index([animalId])
  @@index([fromShelterId])
  @@index([toShelterId])
  @@index([status])
}

// -------------------------------------------------------
// Feeding Schedule (Automatikus etetési rend)
// -------------------------------------------------------

enum FeedingFrequency {
  ONCE_DAILY  // Naponta 1×
  TWICE_DAILY // Naponta 2×
  THREE_DAILY // Naponta 3×
  WEEKLY      // Heti rendszerességgel
}

model FeedingSchedule {
  id                 String           @id @default(cuid())
  shelterId          String
  shelter            Shelter          @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  name               String
  inventoryItemId    String
  inventoryItem      InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  quantityPerFeeding Float
  frequency          FeedingFrequency
  times              String[]         // ["08:00", "18:00"] HH:MM formátum
  weekDays           Int[]            // [0..6] hétfő=0, csak WEEKLY esetén releváns, üres = minden nap
  isActive           Boolean          @default(true)
  nextRunAt          DateTime
  lastRunAt          DateTime?
  note               String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  logs               FeedingLog[]

  @@index([shelterId])
  @@index([isActive, nextRunAt])
}

model FeedingLog {
  id           String          @id @default(cuid())
  scheduleId   String
  schedule     FeedingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleName String
  itemName     String
  unit         String
  quantity     Float
  executedAt   DateTime        @default(now())
  skipped      Boolean         @default(false)
  skipReason   String?
  txId         String?

  @@index([scheduleId])
  @@index([executedAt])
}

// -------------------------------------------------------
// Community posts (menhelyek közösségi posztjai a "Neked" feedhez)
// -------------------------------------------------------

model Post {
  id         String   @id @default(cuid())
  shelterId  String
  authorId   String? // a posztot író menhely-admin (törölt usernél null)
  content    String   @db.Text
  imageUrl   String?
  // Opcionális hivatkozás egy entitásra, amit a poszt kiemel
  animalId   String?
  eventId    String?
  campaignId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shelter  Shelter    @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  author   User?      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  animal   Animal?    @relation(fields: [animalId], references: [id], onDelete: SetNull)
  event    Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  campaign Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  likes    PostLike[]

  @@index([shelterId])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}
