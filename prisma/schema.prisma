// -------------------------------------------------------
// Prisma Schema – Menhely Adoptios Platform
// -------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------
// Enums
// -------------------------------------------------------

enum Role {
  USER
  SHELTER_ADMIN
  SUPER_ADMIN
}

enum AnimalType {
  DOG
  CAT
  RABBIT
  BIRD
  OTHER
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum AnimalStatus {
  AVAILABLE
  PENDING
  ADOPTED
  FOSTER
  MEDICAL_HOLD
}

enum ApplicationStatus {
  INVITED
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum FieldType {
  TEXT
  TEXTAREA
  IMAGE
  FILE
}

enum FormStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// -------------------------------------------------------
// User
// -------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  phone         String?
  address       String?
  city          String?
  country       String    @default("HU")
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  applications  AdoptionApplication[]
  shelterAdmins ShelterAdmin[]
  favorites     Favorite[]
  reports       AnimalReport[]
  conversations       Conversation[]        @relation("ConversationUser")
  sentMessages        Message[]             @relation("MessageSender")
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  donations           Donation[]            @relation("DonationUser")
  campaigns           Campaign[]            @relation("CampaignCreator")
  reviewsWritten      Review[]              @relation("ReviewAuthor")
  reviewsReceived     Review[]              @relation("ReviewTarget")
}

// -------------------------------------------------------
// Password Reset
// -------------------------------------------------------

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------
// NextAuth models
// -------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------------------------
// Shelter (Menhely)
// -------------------------------------------------------

model Shelter {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  address     String
  city        String
  zipCode     String?
  country     String   @default("HU")
  phone       String?
  email       String?
  website     String?
  logoUrl          String?
  coverUrl         String?
  isVerified       Boolean  @default(false)
  isActive         Boolean  @default(true)
  lat              Float?
  lng              Float?
  // Fizetési / cégadatok
  companyName      String?
  taxNumber        String?
  bankAccountName  String?
  bankAccountNumber String?
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  animals              Animal[]
  admins               ShelterAdmin[]
  conversations        Conversation[]
  documents            ShelterDocument[]
  adoptionRequirements String?            @db.Text
  tiers                DonationTier[]
  campaigns            Campaign[]
  applicationForms     ApplicationForm[]
  reviews              Review[]
}

model ShelterDocument {
  id        String   @id @default(cuid())
  shelterId String
  name      String
  url       String
  fileType  String   @default("application/pdf")
  createdAt DateTime @default(now())

  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)
}

model ShelterAdmin {
  id        String   @id @default(cuid())
  userId    String
  shelterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)

  @@unique([userId, shelterId])
}

// -------------------------------------------------------
// Animal (Állat)
// -------------------------------------------------------

model Animal {
  id             String       @id @default(cuid())
  shelterId      String
  name           String
  slug           String       @unique
  type           AnimalType
  breed          String?
  age            Int?          // hónapokban
  size           AnimalSize?
  gender         String?       // "MALE" | "FEMALE" | "UNKNOWN"
  color          String?
  weight         Float?        // kg
  description    String?      @db.Text
  isVaccinated   Boolean      @default(false)
  isNeutered     Boolean      @default(false)
  isMicrochipped Boolean      @default(false)
  isGoodWithKids Boolean?
  isGoodWithDogs Boolean?
  isGoodWithCats Boolean?
  status         AnimalStatus @default(AVAILABLE)
  arrivedAt      DateTime?
  adoptedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shelter       Shelter               @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  images        AnimalImage[]
  documents     AnimalDocument[]
  applications  AdoptionApplication[]
  favorites     Favorite[]
  conversations Conversation[]
}

model AnimalDocument {
  id        String   @id @default(cuid())
  animalId  String
  name      String
  url       String
  fileType  String   @default("application/pdf")
  sizeBytes Int?
  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
}

model AnimalImage {
  id        String   @id @default(cuid())
  animalId  String
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------
// Adoption Application (Örökbefogadási kérelem)
// -------------------------------------------------------

model AdoptionApplication {
  id           String            @id @default(cuid())
  userId       String
  animalId     String
  formId       String?
  inviteToken  String?           @unique
  status       ApplicationStatus @default(PENDING)
  message      String?           @db.Text
  homeType     String?           // "HOUSE" | "APARTMENT" | "OTHER"
  hasGarden    Boolean?
  hasChildren  Boolean?
  hasPets      Boolean?
  experience   String?           @db.Text
  reviewNotes  String?           @db.Text
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal    Animal           @relation(fields: [animalId], references: [id], onDelete: Cascade)
  form      ApplicationForm? @relation(fields: [formId], references: [id], onDelete: SetNull)
  responses FormFieldResponse[]

  @@unique([userId, animalId])
  @@index([inviteToken])
}

// -------------------------------------------------------
// Favorite (Kedvencek)
// -------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  animalId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([userId, animalId])
}

// -------------------------------------------------------
// Animal Report (Elveszett / Megtalált / Kóbor bejelentés)
// -------------------------------------------------------

enum ReportType {
  LOST   // Elveszett
  FOUND  // Megtalált
  STRAY  // Kóbor
}

enum ReportStatus {
  ACTIVE   // Aktív
  RESOLVED // Megoldva
  CLOSED   // Lezárt
}

model AnimalReport {
  id           String       @id @default(cuid())
  userId       String?
  type         ReportType
  animalType   AnimalType
  name         String?
  breed        String?
  color        String?
  gender       String?
  description  String       @db.Text
  city         String
  address      String?
  lat          Float?
  lng          Float?
  imageUrl     String?
  contactName  String
  contactPhone String?
  contactEmail String
  status       ReportStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([city])
  @@index([animalType])
}

// -------------------------------------------------------
// Conversation / Chat
// -------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  animalId  String
  userId    String
  shelterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animal   Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  user     User      @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  shelter  Shelter   @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([animalId, userId])
  @@index([userId])
  @@index([shelterId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String?   @db.Text
  attachmentUrl  String?
  attachmentName String?
  readAt         DateTime?
  type           String    @default("TEXT")
  inviteToken    String?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------
// Donation System
// -------------------------------------------------------

enum CampaignStatus {
  PENDING
  ACTIVE
  COMPLETED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

model DonationTier {
  id          String   @id @default(cuid())
  shelterId   String
  name        String
  description String?  @db.Text
  amount      Int      // HUF / month
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shelter       Shelter        @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([shelterId])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  tierId      String
  status      SubscriptionStatus @default(ACTIVE)
  stripeSubId String?            @unique
  createdAt   DateTime           @default(now())
  cancelledAt DateTime?

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier DonationTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tierId])
}

model Campaign {
  id           String         @id @default(cuid())
  userId       String
  shelterId    String?
  title        String
  slug         String         @unique
  description  String         @db.Text
  targetAmount Int
  raisedAmount Int            @default(0)
  imageUrl     String?
  status       CampaignStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  endsAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user      User       @relation("CampaignCreator", fields: [userId], references: [id])
  shelter   Shelter?   @relation(fields: [shelterId], references: [id], onDelete: SetNull)
  donations Donation[]

  @@index([status])
  @@index([userId])
}

model Donation {
  id              String    @id @default(cuid())
  userId          String?
  campaignId      String?
  tierId          String?
  amount          Int
  message         String?   @db.Text
  isAnonymous     Boolean   @default(false)
  stripeSessionId String?   @unique
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  user     User?     @relation("DonationUser", fields: [userId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
}

// -------------------------------------------------------
// Application Form System
// -------------------------------------------------------

model ApplicationForm {
  id          String     @id @default(cuid())
  shelterId   String
  shelter     Shelter    @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  title       String
  description String?    @db.Text
  status      FormStatus @default(DRAFT)
  fields      FormField[]
  applications AdoptionApplication[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([shelterId])
}

model FormField {
  id        String          @id @default(cuid())
  formId    String
  form      ApplicationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  label     String
  type      FieldType
  required  Boolean         @default(false)
  order     Int             @default(0)
  responses FormFieldResponse[]

  @@index([formId])
}

model FormFieldResponse {
  id            String              @id @default(cuid())
  applicationId String
  application   AdoptionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldId       String
  field         FormField           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value         String?             @db.Text
  fileUrl       String?

  @@index([applicationId])
}

// -------------------------------------------------------
// Reviews
// -------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Szerző (bejelentkezett user vagy shelter admin)
  authorId  String
  author    User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Értékelt menhely (user → shelter irány)
  shelterId String?
  shelter   Shelter? @relation(fields: [shelterId], references: [id], onDelete: Cascade)

  // Értékelt örökbefogadó (shelter → user irány)
  targetUserId String?
  targetUser   User?   @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([authorId, shelterId])        // user csak egyszer értékelheti a menhelyet
  @@unique([authorId, targetUserId])     // shelter csak egyszer értékelheti az örökbefogadót
  @@index([shelterId])
  @@index([targetUserId])
}
