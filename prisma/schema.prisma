// -------------------------------------------------------
// Prisma Schema – Menhely Adoptios Platform
// -------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------
// Enums
// -------------------------------------------------------

enum Role {
  USER
  SHELTER_ADMIN
  SUPER_ADMIN
}

enum AnimalType {
  DOG
  CAT
  RABBIT
  BIRD
  OTHER
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum AnimalStatus {
  AVAILABLE
  PENDING
  ADOPTED
  FOSTER
  MEDICAL_HOLD
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  WITHDRAWN
}

// -------------------------------------------------------
// User
// -------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  phone         String?
  address       String?
  city          String?
  country       String    @default("HU")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  applications  AdoptionApplication[]
  shelterAdmins ShelterAdmin[]
  favorites     Favorite[]
  reports       AnimalReport[]
  conversations Conversation[]        @relation("ConversationUser")
  sentMessages  Message[]             @relation("MessageSender")
}

// -------------------------------------------------------
// NextAuth models
// -------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------------------------
// Shelter (Menhely)
// -------------------------------------------------------

model Shelter {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  address     String
  city        String
  zipCode     String?
  country     String   @default("HU")
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  coverUrl    String?
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  animals       Animal[]
  admins        ShelterAdmin[]
  conversations Conversation[]
}

model ShelterAdmin {
  id        String   @id @default(cuid())
  userId    String
  shelterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelter Shelter @relation(fields: [shelterId], references: [id], onDelete: Cascade)

  @@unique([userId, shelterId])
}

// -------------------------------------------------------
// Animal (Állat)
// -------------------------------------------------------

model Animal {
  id             String       @id @default(cuid())
  shelterId      String
  name           String
  slug           String       @unique
  type           AnimalType
  breed          String?
  age            Int?          // hónapokban
  size           AnimalSize?
  gender         String?       // "MALE" | "FEMALE" | "UNKNOWN"
  color          String?
  weight         Float?        // kg
  description    String?      @db.Text
  isVaccinated   Boolean      @default(false)
  isNeutered     Boolean      @default(false)
  isMicrochipped Boolean      @default(false)
  isGoodWithKids Boolean?
  isGoodWithDogs Boolean?
  isGoodWithCats Boolean?
  status         AnimalStatus @default(AVAILABLE)
  arrivedAt      DateTime?
  adoptedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shelter       Shelter               @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  images        AnimalImage[]
  applications  AdoptionApplication[]
  favorites     Favorite[]
  conversations Conversation[]
}

model AnimalImage {
  id        String   @id @default(cuid())
  animalId  String
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------
// Adoption Application (Örökbefogadási kérelem)
// -------------------------------------------------------

model AdoptionApplication {
  id          String            @id @default(cuid())
  userId      String
  animalId    String
  status      ApplicationStatus @default(PENDING)
  message     String?           @db.Text
  homeType    String?           // "HOUSE" | "APARTMENT" | "OTHER"
  hasGarden   Boolean?
  hasChildren Boolean?
  hasPets     Boolean?
  experience  String?           @db.Text
  reviewNotes String?           @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([userId, animalId])
}

// -------------------------------------------------------
// Favorite (Kedvencek)
// -------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  animalId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([userId, animalId])
}

// -------------------------------------------------------
// Animal Report (Elveszett / Megtalált / Kóbor bejelentés)
// -------------------------------------------------------

enum ReportType {
  LOST   // Elveszett
  FOUND  // Megtalált
  STRAY  // Kóbor
}

enum ReportStatus {
  ACTIVE   // Aktív
  RESOLVED // Megoldva
  CLOSED   // Lezárt
}

model AnimalReport {
  id           String       @id @default(cuid())
  userId       String?
  type         ReportType
  animalType   AnimalType
  name         String?
  breed        String?
  color        String?
  gender       String?
  description  String       @db.Text
  city         String
  address      String?
  lat          Float?
  lng          Float?
  imageUrl     String?
  contactName  String
  contactPhone String?
  contactEmail String
  status       ReportStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([city])
  @@index([animalType])
}

// -------------------------------------------------------
// Conversation / Chat
// -------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  animalId  String
  userId    String
  shelterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animal   Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  user     User      @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  shelter  Shelter   @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([animalId, userId])
  @@index([userId])
  @@index([shelterId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}
